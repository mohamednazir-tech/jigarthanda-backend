# Jigarthanda Backend Environment Variables for Render.com

# Node.js Version
NODE_VERSION=18

# Server Configuration
PORT=3000

# Database Configuration (Get from PostgreSQL service on Render)
# DATABASE_URL=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=jigarthanda_db
# DB_USER=jigarthanda_user
# DB_PASSWORD=

# JWT Secret
JWT_SECRET=jigarthanda_jwt_secret_key_2024

# CORS Configuration
CORS_ORIGIN=https://jigarthanda-backend.onrender.com

# App Configuration
APP_NAME=Jigarthanda POS
APP_VERSION=1.0.0
NODE_ENV=production

# Local Development (comment out for production)
# DATABASE_URL=postgresql://postgres:nazir@localhost:5432/jigarthanda_api_db


